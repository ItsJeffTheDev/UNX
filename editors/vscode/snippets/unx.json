{
  "Say text": {
    "prefix": "say",
    "body": "say \"${1:Hello from UNX}\"",
    "description": "Print a string"
  },
  "Set variable": {
    "prefix": "set",
    "body": "set ${1:name} to \"${2:value}\"",
    "description": "Create or replace a string variable"
  },
  "Comment": {
    "prefix": "comment",
    "body": "# ${1:comment}",
    "description": "Add a line comment"
  },
  "Starter program": {
    "prefix": "unxmain",
    "body": [
      "# My first UNX program",
      "set appName to \"${1:My App}\"",
      "say \"Hello from \"",
      "say appName"
    ],
    "description": "A starter program using the current UNX language subset"
  },
  "GUI button": {
    "prefix": "unxbutton",
    "body": "button \"\u0024{1:Click me}\" say \"\u0024{2:Button clicked!}\"",
    "description": "Add a clickable button to an open UNX window"
  },
  "GUI window": {
    "prefix": "unxgui",
    "body": [
      "open window \"${1:My First UNX App}\"",
      "set window width to \"${2:800}\"",
      "set window height to \"${3:500}\"",
      "",
      "say \"${4:Welcome to UNX!}\""
    ],
    "description": "Create an experimental UNX desktop window"
  }
}
