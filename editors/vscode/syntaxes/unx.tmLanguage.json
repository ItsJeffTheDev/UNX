{
  "scopeName": "source.unx",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.unx",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.unx",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.unx"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.unx"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.unx",
          "match": "\\\\\\\\[\\\\\\\\\"nt]"
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.unx",
      "match": "\\b(say|set|to|open|window|width|height|button|if|equals|else|end|repeat|function|return)\\b"
    },
    "constants": {
      "name": "constant.language.unx",
      "match": "\\b(true|false|null)\\b"
    },
    "numbers": {
      "name": "constant.numeric.integer.unx",
      "match": "\\b[0-9]+\\b"
    },
    "operators": {
      "name": "keyword.operator.arithmetic.unx",
      "match": ">=|<=|==|!=|[+\\-*/%><()]"
    },
    "variables": {
      "name": "variable.other.unx",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
